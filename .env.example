# -----------------------------------------------------------------------------
# App - Do not add a trailing slash
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=asphero@gmail.com

# -----------------------------------------------------------------------------
# Email delivery
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Wappkit <support@wappkit.com>"

# -----------------------------------------------------------------------------
# Billing and license workflows
# -----------------------------------------------------------------------------
# Rotate these secrets before production if they were exposed during testing.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_PRODUCT_AI_ECOM_VISUAL_STUDIO_ID=
CREEM_PRODUCT_WAPPKIT_APP_SETUP_ID=
CREEM_PRODUCT_REDDIT_TOOLBOX_ID=

# -----------------------------------------------------------------------------
# Desktop installer hosting / update metadata
# -----------------------------------------------------------------------------
# Recommended first hosting: GitHub Release asset. Set DOWNLOAD_URL to the direct
# asset URL; Wappkit redirects /api/desktop/.../download to this value.
AI_ECOM_VISUAL_STUDIO_DOWNLOAD_URL=
AI_ECOM_VISUAL_STUDIO_RELEASE_URL=
AI_ECOM_VISUAL_STUDIO_CHECKSUM_URL=
AI_ECOM_VISUAL_STUDIO_SHA256=
WAPPKIT_APP_SETUP_DOWNLOAD_URL=
WAPPKIT_APP_SETUP_RELEASE_URL=
WAPPKIT_APP_SETUP_CHECKSUM_URL=
WAPPKIT_APP_SETUP_SHA256=

# -----------------------------------------------------------------------------
# Optional lightweight persistence for license mirror records
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# -----------------------------------------------------------------------------
# Internal admin access for support operations
# -----------------------------------------------------------------------------
INTERNAL_ADMIN_TOKEN=
